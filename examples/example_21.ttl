@prefix : <http://www.example.com/#> .
@prefix morph: <http://www.w3.org/ns/lemon/morph#> .


:_heit-rule a morph:DerivationRule;
            morph:replacement [
		        morph:sourceRegex "$" ;
		        morph:targetRegex "heit" ;
			    ] ;
            morph:involves :_heit-morph;
            morph:generates :schoenheit-form.

